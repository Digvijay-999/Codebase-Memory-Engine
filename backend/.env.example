# Copy to backend/.env and fill in. Placeholders only - never commit real values.
# docker compose also reads ./.env (repo root) AFTER this file, so a value there overrides this one.

# --- Required for /ask, /analyze, /explain, /generate-readme ---
OPENROUTER_API_KEY=your-openrouter-api-key
# Under docker compose this line is ignored: compose's `environment:` default wins. Set OPENROUTER_MODEL in ./.env instead.
OPENROUTER_MODEL=provider/model-name:free
# Optional comma-separated fallback model ids, tried in order if the primary errors (keep them :free).
# OPENROUTER_FALLBACK_MODELS=
# Optional faster model and fallbacks for whole-repo reports (analyze/explain/readme); empty = use the primary.
# OPENROUTER_MODEL_LONG=
# OPENROUTER_FALLBACK_MODELS_LONG=

# --- Optional (defaults shown) ---
# HOST=0.0.0.0
# PORT=8000
# Cross-origin browser access. Default: none, since the UI calls the API on its own origin at /api.
# Set it only when the frontend is hosted on another origin (VITE_API_URL), e.g. https://app.example.com
# ALLOWED_ORIGINS=
# REPOS_DIR=./repos
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MODEL_DIR=./models/all-MiniLM-L6-v2
# TOP_K_RESULTS=8
# LLM_TOTAL_TIMEOUT_S=85   # total cap per AI request; can only shorten the 60s/85s endpoint limits
# MAX_FILE_SIZE_BYTES=512000
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# EMBEDDING_BATCH_SIZE=64
# CHROMA_BATCH_SIZE=500
# Clone limits (only https://github.com/<owner>/<repo> URLs are accepted). Over a limit, the clone is deleted.
# CLONE_TIMEOUT_S=60
# MAX_REPO_MB=100
# MAX_FILES=5000
# MAX_REPOS=20
# Per-client-IP rate limits per RATE_LIMIT_WINDOW_S seconds (429 + Retry-After when exceeded).
# RATE_LIMIT_WINDOW_S=60
# LLM_RATE_LIMIT=10      # /ask, /analyze, /explain, /generate-readme
# INDEX_RATE_LIMIT=3     # /index, /clone, /store
# SEARCH_RATE_LIMIT=30   # /search
# Global cap on LLM calls per UTC day, across all visitors (429 "Demo limit reached for today").
# LLM_DAILY_LIMIT=200
# production: no /docs, /redoc or /openapi.json. compose.prod.yml sets it.
# APP_ENV=development
# true: enable the debug-only routes /clone, /content, /chunks, /embed, /store (404 otherwise).
# ENABLE_DEBUG_ENDPOINTS=false
# Peers trusted to set X-Forwarded-For (the nginx proxy; docker compose sets it to PROXY_IP).
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend (not read by the backend) ---
# The UI calls /api on its own origin: nginx proxies it to BACKEND_URL, and `npm run dev` proxies it to
# http://localhost:8001. Only to host the frontend separately, bake in another API origin at build time
# (frontend/.env for `npm run build`, or VITE_API_URL in ./.env for docker compose).
# VITE_API_URL=https://api.example.com
