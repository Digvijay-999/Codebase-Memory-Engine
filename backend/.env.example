# Copy to backend/.env and fill in. Placeholders only - never commit real values.
# docker compose also reads ./.env (repo root) AFTER this file, so a value there overrides this one.

# --- Required for /ask, /analyze, /explain, /generate-readme ---
OPENROUTER_API_KEY=your-openrouter-api-key
# Under docker compose this line is ignored: compose's `environment:` default wins. Set OPENROUTER_MODEL in ./.env instead.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Optional (defaults shown) ---
# HOST=0.0.0.0
# PORT=8000
# Default also includes "*" (any origin); list explicit origins in deployment.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# REPOS_DIR=./repos
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# MODEL_DIR=./models/all-MiniLM-L6-v2
# TOP_K_RESULTS=5
# MAX_FILE_SIZE_BYTES=512000
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# EMBEDDING_BATCH_SIZE=64
# CHROMA_BATCH_SIZE=500

# --- Frontend (not read by the backend) ---
# Vite bakes this in at build time: put it in frontend/.env for `npm run dev`,
# or change the VITE_API_URL build arg in docker-compose.yml.
# VITE_API_URL=http://localhost:8001
