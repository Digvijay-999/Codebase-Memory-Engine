# Copy to ./.env (repo root). docker compose reads it for the backend and it overrides backend/.env.
# Placeholders only - never commit real values. The API key itself goes in backend/.env.
# Lines left commented use the defaults in backend/config/settings.py and docker-compose.yml.

# Primary OpenRouter model id (docker-compose.yml's default is used when this is unset).
# OPENROUTER_MODEL=provider/model-name:free
# Optional comma-separated fallbacks, tried in order if the primary errors. Use :free ids to avoid paid billing.
# OPENROUTER_FALLBACK_MODELS=provider/fallback-one:free,provider/fallback-two:free
# Optional total seconds for one AI request incl. retry and fallbacks. Can only shorten the built-in
# limits (60s /ask, 85s whole-repo endpoints), which stay below the UI timeouts.
# LLM_TOTAL_TIMEOUT_S=85
# Optional faster model (and its own fallbacks) for whole-repo reports only (analyze/explain/readme).
# OPENROUTER_MODEL_LONG=provider/fast-model:free
# OPENROUTER_FALLBACK_MODELS_LONG=provider/fast-fallback:free

# Optional: the compose network's fixed subnet and the nginx proxy's IP in it. The backend trusts
# X-Forwarded-For only from PROXY_IP. Change both if the subnet overlaps a network on your host.
# DOCKER_SUBNET=172.30.240.0/24
# PROXY_IP=172.30.240.10

# Optional: where the frontend's nginx proxies /api/ (no trailing slash).
# BACKEND_URL=http://backend:8000
# Optional: host the frontend apart from the API. Baked in at build time; the CSP then allows its origin,
# and the backend must list the frontend's origin in ALLOWED_ORIGINS (empty by default).
# VITE_API_URL=https://api.example.com
# ALLOWED_ORIGINS=https://app.example.com

# --- Production on a single Docker host (compose.prod.yml; see DEPLOY.md) ---
# Makes every `docker compose` command (and the scripts in scripts/) use the production setup.
# COMPOSE_FILE=docker-compose.yml:compose.prod.yml
# The public hostname; its DNS A record must point at the server before the first start (HTTPS certificate).
# DOMAIN=contextforge.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# Caddy's fixed IP in DOCKER_SUBNET (nginx trusts X-Forwarded-For only from it).
# CADDY_IP=172.30.240.20

# --- Small hosts (1 GB RAM, see DEPLOY.md "Low-memory hosts") ---
# The default embedding batch (64) needs more RAM than the host has, and indexing then crawls in swap:
# a 1,084-chunk repo took 626s at 64 and 87s at 8.
# EMBEDDING_BATCH_SIZE=8
# Reject bigger repos with a quick 413, so every accepted repo indexes well inside the UI's 300s timeout.
# Source code shallow-clones to up to ~1,200 chunks per MB, about 90s at 1 MB on that host.
# MAX_FILES=300
# MAX_REPO_MB=1
