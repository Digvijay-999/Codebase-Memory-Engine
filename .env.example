# Copy to ./.env (repo root). docker compose reads it for the backend and it overrides backend/.env.
# Placeholders only - never commit real values. The API key itself goes in backend/.env.

# Primary OpenRouter model id (docker-compose.yml's default is used when this is unset).
OPENROUTER_MODEL=provider/model-name:free
# Optional comma-separated fallbacks, tried in order if the primary errors. Use :free ids to avoid paid billing.
OPENROUTER_FALLBACK_MODELS=provider/fallback-one:free,provider/fallback-two:free
# Optional total seconds for one AI request incl. retry and fallbacks. Can only shorten the built-in
# limits (60s /ask, 85s whole-repo endpoints), which stay below the UI timeouts.
# LLM_TOTAL_TIMEOUT_S=85
# Optional faster model (and its own fallbacks) for whole-repo reports only (analyze/explain/readme).
OPENROUTER_MODEL_LONG=provider/fast-model:free
OPENROUTER_FALLBACK_MODELS_LONG=provider/fast-fallback:free

# Optional: the compose network's fixed subnet and the nginx proxy's IP in it. The backend trusts
# X-Forwarded-For only from PROXY_IP. Change both if the subnet overlaps a network on your host.
# DOCKER_SUBNET=172.30.240.0/24
# PROXY_IP=172.30.240.10
